<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Mi Tienda</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Estilos propios -->
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="bi bi-bag-heart-fill me-2"></i>Mi<span>Tienda</span>
      </a>
      <button class="navbar-toggler" type="button"
              data-bs-toggle="collapse" data-bs-target="#navMenu"
              style="border-color:rgba(255,255,255,.3)">
        <span class="navbar-toggler-icon" style="filter:invert(1)"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
          <li class="nav-item"><a class="nav-link" href="/products">Productos</a></li>
          <li class="nav-item"><a class="nav-link" href="/store/register"><i class="bi bi-shop me-1"></i>Vende con nosotros</a></li>
        </ul>
        <div class="d-flex align-items-center gap-2">
          <!-- Carrito -->
          <a href="/cart" class="btn btn-outline-light btn-sm d-flex align-items-center gap-2">
            <i class="bi bi-cart3"></i>
            Carrito
            <span class="cart-badge"><%= cartItemCount %></span>
          </a>
          <!-- Sesión de usuario -->
          <% if (userSession) { %>
            <a href="/customer/dashboard"
               class="btn btn-light btn-sm d-flex align-items-center gap-1">
              <i class="bi bi-person-circle"></i>
              <span class="d-none d-md-inline"><%= userSession.name.split(' ')[0] %></span>
            </a>
          <% } else { %>
            <a href="/user/login"  class="btn btn-outline-light btn-sm">Iniciar sesión</a>
            <a href="/user/register" class="btn btn-light btn-sm">Registrarse</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
  <main class="container my-4">
    <%- body %>
  </main>
  <footer>
    <div class="container">
      <div class="row text-center text-md-start">
        <div class="col-md-4 mb-3 mb-md-0">
          <h6 class="fw-bold text-white"><i class="bi bi-bag-heart-fill me-2"></i>MiTienda</h6>
          <p class="small mb-0">&copy; <%= new Date().getFullYear() %> MiTienda — Desarrollo de Software IX — UTP</p>
        </div>
        <div class="col-md-4 mb-3 mb-md-0">
          <h6 class="fw-bold text-white">Enlaces</h6>
          <ul class="list-unstyled small mb-0">
            <li><a href="/" class="text-decoration-none" style="color:rgba(255,255,255,.7)">Inicio</a></li>
            <li><a href="/products" class="text-decoration-none" style="color:rgba(255,255,255,.7)">Productos</a></li>
          </ul>
        </div>
        <div class="col-md-4">
          <h6 class="fw-bold text-white"><i class="bi bi-shop me-1"></i>Vende con nosotros</h6>
          <ul class="list-unstyled small mb-0">
            <li><a href="/store/register" class="text-decoration-none" style="color:rgba(255,255,255,.7)">Registra tu tienda</a></li>
            <li><a href="/store/login" class="text-decoration-none" style="color:rgba(255,255,255,.7)">Iniciar sesión como tienda</a></li>
          </ul>
        </div>
      </div>
    </div>
  </footer>
  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <% if (typeof scripts !== 'undefined') { %><%- scripts %><% } %>
</body>
</html>